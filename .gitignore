# Ignore local and cloud media caches.
cache/*
!cache/.gitkeep
!cache/index.json
cache/visitors.json

# Ignore Nginx runtime logs.
nginx/logs/

# Ignore all environment files.
.env
.env.*

# Ignore TLS private keys and local certificates.
nginx/certs/*.key
nginx/certs/*-key.pem
nginx/certs/localhost.pem

# Ignore Nginx local-only configuration.
nginx/nginx.local.conf

